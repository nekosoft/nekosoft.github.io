---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { slugifyTag } from '../utils/tags';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;

// Chronological neighbours (newest first). "Next" is newer, "Previous" is older.
const posts = (
  await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft)
).sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);
const idx = posts.findIndex((p) => p.id === post.id);
const newer = idx > 0 ? posts[idx - 1] : undefined;
const older = idx >= 0 && idx < posts.length - 1 ? posts[idx + 1] : undefined;
---

<BaseLayout title={`${title} — Luda Hex`} description={description}>
  <article class="container post">
    <header>
      <p class="eyebrow">// blog</p>
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={pubDate.toISOString()}>
          {
            pubDate.toLocaleDateString('en-GB', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
        </time>
        <span class="byline">by Yianna Paris</span>
        {
          tags.length > 0 && (
            <ul class="tags">
              {tags.map((tag) => (
                <li>
                  <a href={`/tags/${slugifyTag(tag)}`}>#{tag}</a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </header>
    <div class="prose">
      <slot />
    </div>
    <a class="back" href="/blog">← All posts</a>
    {
      (older || newer) && (
        <nav class="pager" aria-label="Previous and next posts">
          {older ? (
            <a class="prev" href={`/blog/${older.id}/`}>
              <span class="dir">← Previous</span>
              <span class="ptitle">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a class="pnext" href={`/blog/${newer.id}/`}>
              <span class="dir">Next →</span>
              <span class="ptitle">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .post {
    max-width: calc(var(--prose-width) + 2 * var(--space-5));
    padding-block: var(--space-7);
  }

  header {
    margin-bottom: var(--space-6);
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    font-weight: 700;
    line-height: 1.1;
    margin-block: var(--space-2) var(--space-3);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .tags a {
    color: var(--cyan);
  }

  .tags a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .back {
    display: inline-block;
    margin-top: var(--space-6);
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    max-width: 48%;
    text-decoration: none;
    transition:
      border-color 150ms ease,
      box-shadow 150ms ease;
  }

  .pager a:hover {
    border-color: var(--magenta);
    box-shadow: var(--glow-magenta);
  }

  .pager .pnext {
    margin-left: auto;
    text-align: right;
  }

  .pager .dir {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .pager .ptitle {
    color: var(--text);
    font-size: 0.95rem;
  }

  .pager a:hover .ptitle {
    color: var(--magenta);
  }
</style>
