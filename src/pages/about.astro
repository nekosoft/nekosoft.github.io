---
import BaseLayout from '../layouts/BaseLayout.astro';
import { slugifyTag } from '../utils/tags';
import { projects, type WorkItem } from '../data/projects';

// Resume-style facts — edit these lists to keep the about page current.
// A plain string is a static chip. Give an item a `tag` to turn it into a
// link that filters the blog to that keyword (/blog?tag=…). The `tag` must
// match a tag used on a blog post for the filtered view to show anything.
type Chip = string | { label: string; tag: string };

const resume: { label: string; items: Chip[] }[] = [
  {
    label: 'Experience areas',
    items: [
      { label: 'Offensive Security', tag: 'Offensive Security' },
      { label: 'Application Security', tag: 'Application Security' },
      'Open source intelligence',
      { label: 'Reconnaissance and initial access', tag: 'Reconnaissance' },
      'CI/CD Tooling and Controls',
      'Secure Development Practices',
      { label: 'LLM and Agentic AI Security', tag: 'LLM / Agentic AI' },
      'SOC & Incident Response',
      'Threat Hunting',
      'Secure Cloud Architecture',
      'Security Training',
    ],
  },
  {
    label: 'Tech Stack domains',
    items: [
      { label: 'Web & Cloud', tag: 'Web & Cloud' },
      { label: 'Embedded & Hardware', tag: 'Embedded & Hardware' },
      { label: 'Radio & Wireless Protocols - IoT', tag: 'IoT' },
      { label: 'LLM / Agentic AI', tag: 'LLM / Agentic AI' },
    ],
  },
  {
    label: 'Education',
    items: [
      'B.Sc Computer Science · RMIT University · 2021',
      'Prize for Women in Computer Science · 2019',
      'School of Science Excellence Award · 2018',
      'B.Des Digital Media Design',
    ],
  },
  {
    label: 'Professional development',
    items: [
      'AWS ML Engineer (in progress)',
      'OffSec OSWE & OSWP content · 2024',
      'SpecterOps Adversary Tactics: Detections · 2023',
      'MITRE ATT&CK Defender · Adversary Emulation 2023, CTI 2022',
      'InfoSect Canberra · C Code Review 2022, Reverse Engineering 2021',
      'Black Hat · Beyond the Web App Hacker’s Handbook · 2021',
      'OffSec OSCP content · 2020',
    ],
  },
  {
    label: 'Curious about',
    items: [
      'Agriculture',
      'Robotics',
      'Space technologies',
      'Autonomous vehicles',
      'Biometrics and access control',
      'Surveillance technologies',
    ],
  },
];

const cv: {
  period: string;
  role: string;
  org: string;
  summary?: string[];
}[] = [
  { period: '2026 — now', role: 'Founder & Security Researcher', org: 'Luda Hex' },
  {
    period: '2025 — now',
    role: 'Offensive & Software Security Specialist',
    org: 'Xebia',
    summary: [
      'Penetration tests, architecture reviews, threat modelling and targeted research across changing technology stacks.',
      'Bring an offensive perspective into architecture and engineering discussions, where teams naturally understand the intended path better than the ways it can be misused.',
      'Share findings through engineering talks, client workshops and hands-on training, adapting the depth to the people in the room.',
      'Create new courses and workshops centred on secure engineering, cloud and AI.',
    ],
  },
  {
    period: '2024 — 2025',
    role: 'IT Security Lead',
    org: 'ANVA',
    summary: [
      'Led the introduction of secure engineering practices from design to deployment and runtime, where previously only a governance- and policy-based strategy was in place.',
      'Brought secure code review into automated pipelines and local development workflows so engineers received feedback while they were still working on the code.',
      'Connected signals across applications, networks, customer support and employee experience so isolated warnings could be recognised as part of the same incident.',
    ],
  },
  {
    period: '2023 — 2024',
    role: 'Application & Offensive Security Consultant',
    org: 'Xebia',
    summary: [
      'Worked with Lely to bring security into agricultural robotics engineering, where connected-device weaknesses could affect operational and physical safety. Attack surface covered embedded applications, local wireless networks connecting to remote systems, and development environments.',
      'Built and delivered practical training in firmware reverse engineering, cloud and local network exploitation, and attacks against wireless devices.',
    ],
  },
  {
    period: '2020 — 2023',
    role: 'Security Engineer',
    org: 'SEEK',
    summary: [
      'Helped grow an early threat-intelligence capability into what is now a dedicated function.',
      'Hosted capture-the-flag exercises in which developers practised exploiting the weaknesses they were learning to prevent.',
      'Attack-surface expert on the offensive security team — social engineering, physical pentesting, and remote technical systems, from street to corporate network to server room.',
    ],
  },
];

const impact: string[] = [
  'Security-tested production LLMs, chatbots and agents — demonstrating jailbreaks and critical attack paths, including authentication and race-condition flaws, poisoned-corpus prompt injection that bypassed guardrails, and an overly permissive agent sandbox that enabled root-level RCE and persistent data exfiltration.',
  'Hands-on with hardware and IoT: rooted and backdoored webcams, sniffed and analysed radio signals (BLE, Bluetooth Classic, Wi-Fi, Zigbee), and developed the research into an IoT exploitation masterclass delivered as co-trainer at DEF CON.',
  'Helped hundreds of engineers improve their security workflows by teaching and implementing agentic, deterministic and manual techniques — correlating and filtering signals across code, configuration and production to shorten the time from discovery to proven exploit.',
  'Developed current research into paid client trainings: AWS Security in the Age of AI, LLM and Agentic Hacking, From Secure Code Review to Hackbot, and a Threat Modelling workshop.',
  'Discovered compromised containerised workloads in AWS-hosted client applications using threat hunting, code review and cloud security controls.',
  'Assessed and designed cloud IAM architectures and account/project structures across AWS, Google Cloud and Nebius — separating production, development, sandbox and centralised logging environments to support separation of duties.',
];

const research: { title: string; detail: string }[] = [
  {
    title: 'AI-assisted security research & LLM guardrail testing',
    detail:
      'Custom test harnesses with per-experiment cost tracking. Moving beyond jailbreak testing to measuring the effectiveness of cloud-provided guardrails and open-weight safety classifiers. Comparing security workflows across Opus, Sonnet, Sol, GLM and more — connecting an organisation’s security objectives with the logic actually implemented in their code.',
  },
  {
    title: 'Wi-Fi motion sensing & radio frequency intelligence',
    detail:
      'Programming ESP32 chips and experimenting with channel-state information for motion sensing. Analysing smart "spy" glasses and cheap electronics and the potential for detecting these devices. Exploring what ordinary wireless signals can reveal about people and critical infrastructure — feeding into a new IoT course.',
  },
];

const talks: WorkItem[] = [
  {
    name: 'IoT Exploitation Masterclass: Hardware & RF Hacking',
    detail: 'DEF CON Training, Singapore · 2026 · with Smriti Gaba',
    href: 'https://training.defcon.org/products/iot-exploitation-masterclass-hardware-rf-hacking-smriti-gaba-yianna-paris-dctlv2026',
  },
  {
    name: 'Would you let an agent fix production at 3am?',
    detail: 'GoDataFest · 2026',
    href: 'https://events.xebia.com/cloud-data-modernization/godatafest-2026',
  },
  {
    name: 'I jailbroke a scam bot with 1 prompt, and so can you',
    detail: 'WICCON · 2026',
    href: 'https://program.wiccon.nl/wiccon-2026/talk/DGAYA3/',
  },
  {
    name: 'One arrow, multiple breaches: what I’ve learned jailbreaking AI chatbots',
    detail: 'Techorama Netherlands · 2026',
    href: 'https://www.techorama.nl/schedule/sessions/1246988',
  },
  {
    name: 'Cracking the API: Challenges in IoT and Modern Applications',
    detail: 'OWASP Netherlands · 2024',
    href: 'https://owasp.org/www-chapter-netherlands/pastevents',
  },
  {
    name: 'Threat Hunting: More than blue, it’s a team sport',
    detail: 'The Diana Initiative · 2023',
    href: 'https://www.youtube.com/watch?v=hYM0hW9-GL4',
  },
  {
    name: 'Scripted Recon Workshop',
    detail: '0xcc · 2023',
    href: 'https://0xcc.sh/sr.html',
  },
  {
    name: 'Recon and bug bounty hunting w/ Jason Haddix',
    detail: 'Red Team Village, DEF CON · 2023',
  },
  {
    name: 'Building secure apps starts with secure relationships',
    detail: 'The Diana Initiative · 2022',
    href: 'https://www.youtube.com/watch?v=yBsAj5Vs0BU',
  },
];

const writing: WorkItem[] = [
  {
    name: 'Hacker Origin Stories: Yianna Paris',
    detail: 'Volkis · interview',
    href: 'https://www.linkedin.com/pulse/hacker-origin-stories-yianna-paris-volkis',
  },
  {
    name: 'Cyber Consulting Room — Episode 4',
    detail: 'podcast',
    href: 'https://podcast.cyberconsultingroom.com/2264569/13996936',
  },
  {
    name: 'Governance in agile teams',
    detail: 'ISACA NL Journal · 2023 · with Dave van Stein',
    href: 'https://isaca.nl/people/yianna-paris/',
  },
  {
    name: 'From Excel to Excellence: Revitalizing IT Risk Strategies',
    detail: 'ISACA NL Journal · 2024 · with Dave van Stein',
    href: 'https://isaca.nl/people/yianna-paris/',
  },
];

const workGroups: { label: string; accent: string; items: WorkItem[] }[] = [
  { label: 'Projects', accent: 'magenta', items: projects },
  { label: 'Talks & training', accent: 'cyan', items: talks },
  { label: 'Writing & press', accent: 'purple', items: writing },
];
---

<BaseLayout
  title="About — Luda Hex"
  description="About Yianna Paris — background, career, independent research, projects, talks and writing."
>
  <section class="container narrow intro">
    <div class="prose">
      <p class="eyebrow">// about</p>
      <h1>Hi, I'm Yianna</h1>
      <p>I like to break systems and help others build them securely.</p>
      <p>
        I'm a consultant in Offensive and Application Security. You can find me
        speaking at conferences, training at events such as DEFCON or creating
        security workshops for private companies.
      </p>
      <p>
        They told me buffer overflows were dead, and then I discovered IoT and embedded
        software still have these issues. They also said the same about SQL injection,
        then we hooked up Agentic AI and LLMs to databases and reimagined the problem.
        Telling me it's impossible or too difficult just makes me try harder. I am
        comfortable reading, analysing and quickly getting up to speed in almost any tech stack.
      </p>
      <p>
        My broad experience in various security domains gives me the
        organisational context and empathy needed to help bridge knowledge gaps
        and find the important problems.
      </p>
      <p class="find">
        Find me on
        <a href="https://www.linkedin.com/in/salted-hash/">LinkedIn</a> or
        <a href="https://github.com/nekosoft">GitHub</a>.
      </p>
    </div>
    <img
      class="mascot"
      src="/images/skull_script_kitty.svg"
      alt=""
      width="200"
      height="200"
    />
  </section>

  <section class="container narrow">
    <dl class="resume">
      {
        resume.map((row) => (
          <div class="row">
            <dt>{row.label}</dt>
            <dd>
              <ul class="chips">
                {row.items.map((item) => {
                  const label = typeof item === 'string' ? item : item.label;
                  const tag = typeof item === 'string' ? undefined : item.tag;
                  return (
                    <li>
                      {tag ? (
                        <a class="chip chip-link" href={`/tags/${slugifyTag(tag)}`}>
                          {label}
                        </a>
                      ) : (
                        <span class="chip">{label}</span>
                      )}
                    </li>
                  );
                })}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="container narrow impact">
    <h2>Impact in 2026</h2>
    <ul class="impact-list">
      {impact.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="container narrow career">
    <h2>Career</h2>
    <ol class="cv-list">
      {
        cv.map((job) => (
          <li class="cv-row">
            <span class="cv-period">{job.period}</span>
            <div class="cv-role">
              <strong>{job.role}</strong> · {job.org}
              {job.summary && (
                <ul class="cv-summary">
                  {job.summary.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
    <p class="cv-earlier">
      Earlier experience spans 10+ years, including software development at
      SEEK, building a full-stack product as a founder at Yolko, and teaching
      at RMIT and the University of Melbourne.
    </p>
  </section>

  <section class="container narrow research">
    <h2>Independent research</h2>
    <div class="research-list">
      {
        research.map((item) => (
          <article class="research-item">
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="container narrow work">
    <h2>Projects &amp; appearances</h2>
    {
      workGroups.map((group) => (
        <div class="work-group">
          <h3>{group.label}</h3>
          <div class="work-grid">
            {group.items.map((item) => {
              const Tile = item.href ? 'a' : 'div';
              return (
                <Tile class:list={['work-tile', group.accent]} href={item.href}>
                  <div class="tile-top">
                    {item.tag && <span class="work-pill">{item.tag}</span>}
                    {item.href && (
                      <span class="tile-arrow" aria-hidden="true">
                        ↗
                      </span>
                    )}
                  </div>
                  <h4>{item.name}</h4>
                  <p>{item.detail}</p>
                </Tile>
              );
            })}
          </div>
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  .intro {
    display: flex;
    gap: var(--space-7);
    align-items: flex-start;
    padding-top: var(--space-7);
    padding-bottom: var(--space-6);
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    font-weight: 500;
    margin-block: var(--space-2) var(--space-4);
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 500;
    margin-block: 0 var(--space-5);
  }

  /* the eyebrow lives inside .prose here, so cancel the inherited paragraph
     margin to match the top spacing of the blog and experience pages */
  .intro .prose .eyebrow {
    margin-block: 0;
  }

  .find {
    color: var(--text-muted);
  }

  .mascot {
    flex-shrink: 0;
    filter: drop-shadow(0 0 30px rgba(167, 139, 250, 0.25));
  }

  /* resume block */
  .resume {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--border);
  }

  .row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--space-5);
    align-items: baseline;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cyan);
    padding-top: 3px;
  }

  dd {
    margin: 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .chip {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    font-size: 0.9rem;
    background: var(--bg-raise);
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  /* static, non-interactive chip — muted so it doesn't read as clickable */
  span.chip {
    color: var(--text-muted);
  }

  /* linked chip — filters the blog by this keyword */
  .chip-link {
    color: var(--text);
    cursor: pointer;
    transition:
      border-color 150ms ease,
      color 150ms ease;
  }

  .chip-link::after {
    content: '↗';
    margin-left: 0.35em;
    font-size: 0.8em;
    color: var(--cyan);
    opacity: 0.75;
  }

  .chip-link:hover {
    border-color: var(--cyan);
    color: var(--cyan);
  }

  /* merged-in sections from the former experience page */
  .impact {
    padding-top: var(--space-7);
  }

  .impact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .impact-list li {
    position: relative;
    padding-left: var(--space-4);
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .impact-list li::before {
    content: '▸';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--magenta);
    font-size: 0.78rem;
    line-height: 1.75;
  }

  .career {
    padding-top: var(--space-7);
  }

  .research {
    padding-top: var(--space-7);
  }

  .research-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .research-item {
    border-left: 2px solid var(--purple);
    padding-left: var(--space-4);
  }

  .research-item h3 {
    font-size: 1.02rem;
    font-weight: 600;
    margin-bottom: var(--space-2);
    color: var(--text);
  }

  .research-item p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .work {
    padding-top: var(--space-7);
    padding-bottom: var(--space-8);
  }

  /* career timeline */
  .cv-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .cv-row {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  .cv-period {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--cyan);
    white-space: nowrap;
  }

  .cv-role {
    font-size: 0.98rem;
    color: var(--text-muted);
  }

  .cv-role strong {
    font-weight: 600;
    color: var(--text);
  }

  .cv-summary {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .cv-summary li {
    position: relative;
    padding-left: var(--space-3);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .cv-summary li::before {
    content: '·';
    position: absolute;
    left: 2px;
    top: -2px;
    color: var(--cyan);
    font-size: 1.1rem;
  }

  .cv-earlier {
    margin-top: var(--space-4);
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  /* projects & appearances */
  .work-group + .work-group {
    margin-top: var(--space-6);
  }

  .work-group h3 {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cyan);
    margin-bottom: var(--space-3);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-4);
  }

  .work-tile {
    --a: var(--magenta);
    --a2: var(--cyan);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background: linear-gradient(155deg, var(--bg-raise), var(--bg-inset));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    overflow: hidden;
    transition:
      border-color 150ms ease,
      box-shadow 150ms ease,
      transform 150ms ease;
  }

  /* gradient accent bar along the top of each tile */
  .work-tile::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--a), var(--a2));
  }

  .work-tile.cyan {
    --a: var(--cyan);
    --a2: var(--purple);
  }

  .work-tile.purple {
    --a: var(--purple);
    --a2: var(--magenta);
  }

  a.work-tile:hover {
    transform: translateY(-3px);
    border-color: var(--a);
    box-shadow: 0 10px 32px -12px var(--a);
  }

  .tile-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 18px;
  }

  .work-pill {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border-radius: 999px;
    color: var(--a);
    border: 1px solid color-mix(in srgb, var(--a) 45%, transparent);
    background: color-mix(in srgb, var(--a) 12%, transparent);
  }

  .tile-arrow {
    margin-left: auto;
    color: var(--a);
    font-size: 0.9rem;
    opacity: 0.65;
  }

  a.work-tile:hover .tile-arrow {
    opacity: 1;
  }

  .work-tile h4 {
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.3;
  }

  a.work-tile:hover h4 {
    color: var(--a);
  }

  .work-tile p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (max-width: 700px) {
    .intro {
      flex-direction: column-reverse;
      align-items: center;
      text-align: center;
    }

    .find {
      text-align: center;
    }
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }

  @media (max-width: 520px) {
    .cv-row {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
