---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { hostedProjects, otherProjects } from '../data/projects';
---

<BaseLayout
  title="Projects — Luda Hex"
  description="Hands-on security sessions you can run in the browser, plus open-source and client work by Yianna Paris."
>
  <header class="container narrow head">
    <p class="eyebrow">// projects</p>
    <h1 class="sr-only">Projects</h1>
  </header>

  <section class="container narrow hosted" aria-label="Hosted projects">
    <div class="other-grid hosted-grid">
      {
        hostedProjects.map((item, i) => (
          <a class:list={['other-tile', 'session', i % 2 === 1 && 'alt']} href={item.href}>
            <div class="tile-top">
              <span class="pill">{item.kicker}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </div>
            <h3>{item.name}</h3>
            <p>{item.detail}</p>
            <ul class="facts">
              {item.facts.map((fact) => (
                <li>{fact}</li>
              ))}
            </ul>
          </a>
        ))
      }
    </div>
    <p class="note">
      Facilitating one of these? Each session carries its own notes — answer
      sheets, timings and debrief prompts — linked from inside the page.
    </p>
  </section>

  <section class="container narrow elsewhere" aria-labelledby="elsewhere-heading">
    <h2 id="elsewhere-heading">Open source &amp; client work</h2>
    <div class="other-grid">
      {
        otherProjects.map((item) => {
          const Tile = item.href ? 'a' : 'div';
          return (
            <Tile class="other-tile" href={item.href}>
              <div class="tile-top">
                {item.tag && <span class="pill">{item.tag}</span>}
                {item.href && (
                  <span class="arrow" aria-hidden="true">
                    ↗
                  </span>
                )}
              </div>
              <h3>{item.name}</h3>
              <p>{item.detail}</p>
            </Tile>
          );
        })
      }
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  .head {
    padding-top: var(--space-7);
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    font-weight: 500;
    margin-block: var(--space-2) var(--space-3);
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 500;
    margin-block: 0 var(--space-5);
  }

  .hosted {
    padding-top: var(--space-4);
  }

  /* last section before the contact strip: same breathing room as the home page */
  .elsewhere {
    padding-block: var(--space-7) var(--space-8);
  }

  .note {
    margin-top: var(--space-5);
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  /* hosted projects use the same tiles as the work below, with their own
     accent colours and a strip along the top */
  .other-tile.session {
    --a: var(--magenta);
    --a2: var(--cyan);
    position: relative;
    overflow: hidden;
  }

  .other-tile.session.alt {
    --a: var(--cyan);
    --a2: var(--purple);
  }

  .session::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--a), var(--a2));
  }

  /* with an odd number of projects the newest one spans the full row,
     so the rest pair up and none is left on its own at the bottom */
  .hosted-grid > :first-child:nth-last-child(odd) {
    grid-column: 1 / -1;
  }

  .hosted-grid > :first-child:nth-last-child(odd) p {
    max-width: 68ch;
  }

  /* format facts sit along the bottom, so tiles side by side line up */
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: auto 0 0;
    padding-top: var(--space-3);
  }

  .facts li {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 2px 9px;
  }

  /* open source & consulting — compact tiles */
  .other-grid {
    display: grid;
    /* two per row, so four tiles never leave one stranded on its own */
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-4);
  }

  .other-tile {
    --a: var(--purple);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--bg-raise);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    transition:
      border-color 150ms ease,
      transform 150ms ease;
  }

  a.other-tile:hover {
    transform: translateY(-3px);
    border-color: var(--a);
  }

  .tile-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 18px;
  }

  .pill {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border-radius: 999px;
    color: var(--a);
    border: 1px solid color-mix(in srgb, var(--a) 45%, transparent);
    background: color-mix(in srgb, var(--a) 12%, transparent);
  }

  .arrow {
    margin-left: auto;
    color: var(--a);
    font-size: 0.9rem;
    opacity: 0.65;
  }

  a.other-tile:hover .arrow {
    opacity: 1;
  }

  .other-tile h3 {
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.3;
  }

  a.other-tile:hover h3 {
    color: var(--a);
  }

  .other-tile p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
